{
    "name": "Talmud Bot - Ultimate DE (V7 - Expansion + Rerank + Chain of Thought - German)",
    "nodes": [
        {
            "parameters": {
                "updates": [
                    "message"
                ],
                "additionalFields": {}
            },
            "name": "Telegram Trigger",
            "type": "n8n-nodes-base.telegramTrigger",
            "typeVersion": 1,
            "position": [
                100,
                300
            ],
            "credentials": {
                "telegramApi": {
                    "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
                    "name": "Telegram account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const msg=$('Telegram Trigger').first().json.message;const userText=msg.text||\"\";const replyText=msg.reply_to_message?msg.reply_to_message.text:\"\";let finalQuery=userText;if(replyText){finalQuery=`Context: ${replyText}\\nQuestion: ${userText}`}return[{json:{query:finalQuery,original_query:userText}}];"
            },
            "name": "Prepare Context",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                300,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/chat/completions",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "gpt-3.5-turbo"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [ {\"role\": \"system\", \"content\": \"You are a Talmudic Search Engine optimizer. Your job is to EXPAND the user query into better search terms.\\n\\nOutput ONLY the expanded search string in Hebrew/Aramaic.\\n\\nRules:\\n1. Add synonyms for key concepts (e.g. 'Irrigation' -> 'Hashkaja' 'Beit Hashlachin').\\n2. If the user uses modern Hebrew, add the Aramaic equivalent found in Gemara.\\n3. If the user writes in German, identify the Talmudic concepts and translate to Hebrew/Aramaic search terms.\\n4. Keep it concise.\"}, {\"role\": \"user\", \"content\": $json.query} ] }}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Query Expander",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                500,
                300
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/embeddings",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "text-embedding-ada-002"
                        },
                        {
                            "name": "input",
                            "value": "={{$json.choices[0].message.content}}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Embed Expanded Query",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                700,
                300
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "url": "http://qdrant:6333/collections/talmud_vectors/points/search",
                "method": "POST",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "vector",
                            "value": "={{$json.data[0].embedding}}"
                        },
                        {
                            "name": "limit",
                            "value": 20
                        },
                        {
                            "name": "with_payload",
                            "value": true
                        }
                    ]
                },
                "options": {}
            },
            "name": "Qdrant Search (Broad 20)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                900,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const items=$input.all();const queryData=$('Prepare Context').first().json;const origQuery=queryData.query;const searchResult=items[0]?items[0].json.result:[];const candidates=Array.isArray(searchResult)?searchResult:[];const candidatesText=candidates.map((c,i)=>`ID: ${i}\\nCONTENT: ${c.payload.text_content.substring(0,300)}...`).join(\"\\n\\n\");const judgePrompt=`You are an expert Judge of relevance. The user asked: \"${origQuery}\".\\n\\nHere are 20 snippets from the Talmud.\\nYour job: Pick the Top 5 most relevant snippets that answer the question.\\n\\nOutput ONLY a JSON array of IDs. Example: [0, 4, 12, 1, 9]\\n\\nSNIPPETS:\\n${candidatesText}`;return[{json:{system_prompt:judgePrompt,candidates:candidates,user_query:origQuery}}];"
            },
            "name": "Prepare Judge",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1100,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/chat/completions",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "gpt-3.5-turbo"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [ {\"role\": \"system\", \"content\": $json.system_prompt} ] }}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "The Judge (Reranker)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1300,
                300
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const judgeResp=$input.first().json.choices[0].message.content;const prevData=$('Prepare Judge').first().json;const candidates=prevData.candidates;let selectedIds=[];try{selectedIds=JSON.parse(judgeResp)}catch(e){selectedIds=[0,1,2,3,4]}const topResults=selectedIds.map(id=>candidates[id]).filter(i=>i);const sources=topResults.map((point,index)=>{const payload=point.payload||{};const text=payload.text_content||payload.content||\"\";const meta=payload;const citation=`[${meta.masechet||\"Source\"} ${meta.daf||index+1}]`;return`SOURCE ${index+1} ${citation}:\\n${text}`}).join(\"\\n\\n--------------------\\n\\n\");const analystPrompt=`Du bist ein EXPERTE FÜR TALMUDISCHE ANALYSE (Iyun).\\nDeine Aufgabe: Analysiere die untenstehenden Quellen, um die Frage zu beantworten: \"${prevData.user_query}\".\\n\\nVersuche NICHT, dem Benutzer direkt zu antworten.\\nTU FOLGENDES:\\n1. Identifiziere die SCHEINBAREN WIDERSPRÜCHE.\\n2. Finde die ZUGRUNDELIEGENDEN PRINZIPIEN (Swara).\\n3. Verbinde die Quellen miteinander.\\n\\nROHQUELLEN (Vom Richter sortiert):\\n${sources}\\n`;return[{json:{system_prompt:analystPrompt,sources_raw:sources,user_query:prevData.user_query}}];"
            },
            "name": "Build Analyst Prompt",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1500,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/chat/completions",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "gpt-4o"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [ {\"role\": \"system\", \"content\": $json.system_prompt} ] }}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "AI Analyst (Thinking)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                1700,
                300
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const analysis=$input.first().json.choices[0].message.content;const prevData=$('Build Analyst Prompt').first().json;const sources=prevData.sources_raw;const query=prevData.user_query;const ravPrompt=`Du bist ein PÄDAGOGISCHER UND TIEFGRÜNDIGER RAV (Lamdan).\\nDein Schüler (Chavruta) hat dir diese Frage gestellt: \"${query}\".\\n\\nHier sind die FORSCHUNGSNOTIZEN deines besten Analysten:\\n==========\\n${analysis}\\n==========\\n\\nHier sind die ORIGINAL-QUELLEN als Referenz:\\n==========\\n${sources}\\n==========\\n\\nDEINE AUFGABE:\\nVerfasse die endgültige Antwort auf Deutsch.\\n1. Sei KLAR aber TIEFGRÜNDIG (Hohe Spannung).\\n2. Zitiere immer deine Quellen [Masechet Daf].\\n3. Sei warmherzig (Chavruta-Ton).\\n`;return[{json:{system_prompt:ravPrompt}}];"
            },
            "name": "Build Rav Prompt",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1900,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.openai.com/v1/chat/completions",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "openAiApi",
                "sendBody": true,
                "contentType": "json",
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "model",
                            "value": "gpt-4o"
                        },
                        {
                            "name": "messages",
                            "value": "={{ [ {\"role\": \"system\", \"content\": $json.system_prompt} ] }}"
                        }
                    ]
                },
                "options": {}
            },
            "name": "AI Rav (Final Answer)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4,
            "position": [
                2100,
                300
            ],
            "credentials": {
                "openAiApi": {
                    "id": "YOUR_OPENAI_CREDENTIAL_ID",
                    "name": "OpenAI account"
                }
            }
        },
        {
            "parameters": {
                "chatId": "={{$('Telegram Trigger').item.json.message.chat.id}}",
                "text": "={{$json.choices[0].message.content}}",
                "additionalFields": {
                    "parse_mode": "Markdown"
                }
            },
            "name": "Telegram Reply",
            "type": "n8n-nodes-base.telegram",
